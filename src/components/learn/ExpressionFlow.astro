<div class="expression-flow" role="img" aria-label="The text mug flows into Text.toUpper, producing MUG, then Text.append ready produces MUG ready.">
  <code>"mug"</code><span class="connector" aria-hidden="true"></span>
  <div><code>Text.toUpper</code><strong>"MUG"</strong></div><span class="connector" aria-hidden="true"></span>
  <div><code>Text.append " ready"</code><strong>"MUG ready"</strong></div>
</div>
<style>
.expression-flow { display:flex; align-items:center; margin:2rem 0; font-size:1rem; }
.expression-flow > code,.expression-flow > div { border:1px solid var(--sl-color-gray-4); padding:1rem; border-radius:4px; background:var(--sl-color-gray-7,var(--sl-color-gray-6)); }
.expression-flow code { font-size:1rem; white-space:nowrap; }
.expression-flow strong { display:block; font:inherit; margin-top:0.75rem; color:var(--sl-color-text-accent); }
