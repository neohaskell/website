<section class="readiness-flow" aria-label="HTTP health answers independently of query replay readiness">
  <div class="health"><strong>HTTP is answering</strong><span>/health: 200, ok</span></div>
  <div class="rebuild" data-diagram-role="query"><strong>Rebuilding queries</strong><span>/ready: 503, rebuilding</span></div>
  <div class="branches">
    <div class="branch"><span class="connection">Replay completes</span><div class="ready" data-diagram-role="query"><strong>Ready</strong><span>/ready: 200, ready</span></div></div>
    <div class="branch"><span class="connection">Replay fails</span><div class="failed"><strong><span aria-hidden="true">× </span>Failed</strong><span>/ready: 503, failed</span></div></div>
  </div>
</section>
<style>
.readiness-flow{font-size:16px;line-height:1.5;margin:2rem 0}.health{border-left:2px solid var(--sl-color-gray-3);padding:8px 16px;margin-bottom:24px}.readiness-flow strong,.readiness-flow span{display:block}.readiness-flow strong{font-weight:600}.rebuild,.ready{border:2px solid var(--diagram-query-line);color:var(--diagram-query-ink);padding:16px}.rebuild{max-width:320px;margin:auto;position:relative}.rebuild:after{content:'';position:absolute;left:50%;bottom:-26px;height:24px;border-left:2px solid var(--sl-color-gray-3)}.readiness-flow .branches,.readiness-flow .branch{margin-top:0}.branches{display:grid;grid-template-columns:1fr 1fr;gap:24px;position:relative;padding-top:24px}.branches:before{content:'';position:absolute;top:24px;left:calc(25% - 6px);right:calc(25% - 6px);border-top:2px solid var(--sl-color-gray-3)}.connection{position:relative;text-align:center;padding:28px 0 12px}.connection:before{content:'';position:absolute;top:0;left:50%;height:20px;border-left:2px solid var(--sl-color-gray-3)}.connection:after{content:'';position:absolute;top:16px;left:calc(50% - 4px);border-top:8px solid var(--sl-color-gray-3);border-left:5px solid transparent;border-right:5px solid transparent}.failed{border:2px dashed var(--sl-color-red);padding:16px;color:var(--sl-color-red-high)}.failed strong span{display:inline}
@media(max-width:600px){.branches{grid-template-columns:1fr;gap:16px;margin-left:16px;padding:0 0 0 16px;border-left:2px solid var(--sl-color-gray-3)}.branches:before{display:none}.rebuild{max-width:none}.rebuild:after{display:none}.connection{text-align:left;padding:16px 0 12px}.connection:before{top:28px;left:-18px;width:12px;height:0;border-top:2px solid var(--sl-color-gray-3);border-left:0}.connection:after{top:24px;left:-8px;border-left:8px solid var(--sl-color-gray-3);border-top:5px solid transparent;border-bottom:5px solid transparent;border-right:0}}
</style>
