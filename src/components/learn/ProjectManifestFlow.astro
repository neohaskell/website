<div class="manifest-flow" role="img" aria-label="You edit neo.json. Neo reconciles it into the generated Cabal package, cabal.project and flake.nix files before building.">
  <div class="input"><span>You edit</span><code>neo.json</code></div>
  <div class="arrow" aria-hidden="true"></div>
  <div class="process">Neo reconciles</div>
  <div class="arrow" aria-hidden="true"></div>
  <div class="outputs"><span>Generated</span><code>mug-shop.cabal</code><code>cabal.project</code><code>flake.nix</code></div>
</div>
<style>
.manifest-flow{display:grid;grid-template-columns:1fr 24px 1fr 24px 1.4fr;align-items:center;margin:2rem 0;font-size:16px;line-height:1.5}.manifest-flow>*{margin:0}.input,.outputs{display:flex;flex-direction:column;gap:8px;padding:16px;border:1px solid var(--sl-color-gray-4)}.input{border-color:var(--sl-color-text-accent)}.manifest-flow code{font-size:16px}.input span,.outputs span{color:var(--sl-color-gray-2)}.process{text-align:center;padding:8px}.arrow{height:1px;background:var(--sl-color-gray-3);position:relative;margin:0 4px}.arrow:after{content:'';position:absolute;right:0;top:-3px;width:7px;height:7px;border-top:1px solid var(--sl-color-gray-3);border-right:1px solid var(--sl-color-gray-3);transform:rotate(45deg)}@media(max-width:600px){.manifest-flow{grid-template-columns:1fr;gap:8px}.arrow{height:24px;width:1px;margin:0 auto}.arrow:after{right:-3px;top:auto;bottom:0;transform:rotate(135deg)}.process{text-align:left;padding-left:16px}}

:global(.manifest-fields),:global(.dependency-forms){overflow-x:auto}
:global(.manifest-fields table){display:table;min-width:560px}
:global(.manifest-fields td:first-child){min-width:180px}
:global(.dependency-forms table){display:table;min-width:760px}
:global(.dependency-forms td:nth-child(2)){min-width:320px}
</style>
