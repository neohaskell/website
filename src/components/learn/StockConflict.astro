<figure class="stock-conflict" aria-label="Order B reloads stock and runs its decision again after order A advances the stream.">
  <div class="step">A and B load the same position<br /><strong>2 mugs available</strong></div>
  <div class="flow" aria-hidden="true"></div>
  <div class="step" data-diagram-role="event">A appends OrderPlaced<br /><strong>1 mug remains</strong></div>
  <div class="flow" aria-hidden="true"></div>
  <div class="step failure"><strong>B's append blocked</strong><br />Expected position is stale</div>
  <div class="flow" aria-hidden="true"></div>
  <div class="step">B reloads: 1 mug<br />Decision runs again</div>
  <div class="flow" aria-hidden="true"></div>
  <div class="step failure"><strong>B rejected</strong><br />Reserved for in-person sales<br />No event appended for B</div>
</figure>
