---
import { messages } from '../../i18n/runtime';
const t = messages(Astro.locals.starlightRoute.locale ?? 'en');
---
<div class="reusable-integration" role="img" aria-label={t("lesson.integration-reusable-description")}>
  <div class="node" data-diagram-role="event">{t("lesson.integration-recorded-order")}</div>
  <div class="connector">{t("lesson.integration-reusable-map-event")}<svg viewBox="0 0 20 28" aria-hidden="true"><path d="M10 0V24M4 18L10 24L16 18" /></svg></div>
  <section>
    <h3>{t("lesson.integration-reusable-module")}</h3>
    <div class="node">Shipping.Request</div>
    <div class="connector"><svg viewBox="0 0 20 28" aria-hidden="true"><path d="M10 0V24M4 18L10 24L16 18" /></svg></div>
    <div class="node" data-diagram-role="integration">{t("lesson.integration-reusable-http-decode")}</div>
    <div class="connector"><svg viewBox="0 0 20 28" aria-hidden="true"><path d="M10 0V24M4 18L10 24L16 18" /></svg></div>
    <div class="node">{t("lesson.integration-reusable-response")}</div>
  </section>
  <div class="connector">{t("lesson.integration-reusable-map-result")}<svg viewBox="0 0 20 28" aria-hidden="true"><path d="M10 0V24M4 18L10 24L16 18" /></svg></div>
  <div class="node" data-diagram-role="command">RecordShipmentBooking</div>
</div>
<style>
.reusable-integration{margin:32px 0;font-size:16px;line-height:1.5;}
section{border:1px dashed var(--sl-color-gray-3);border-radius:8px;padding:16px;}
section h3{font-size:16px;font-weight:500;margin:0 0 16px;}
.node{padding:12px;border:1px solid var(--diagram-line);border-radius:8px;background:var(--diagram-surface);color:var(--diagram-ink);text-align:center;overflow-wrap:anywhere;}
.connector{display:flex;flex-direction:column;align-items:center;text-align:center;padding:8px;gap:4px;}
.connector svg{width:20px;height:28px;fill:none;stroke:var(--sl-color-gray-2);stroke-width:1.5;}
</style>
