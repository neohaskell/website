<div class="command-contract" role="img" aria-label="IncrementCounter and current state enter decide. Positive amount proposes CounterIncremented for storage; zero amount terminates in rejection without an append.">
  <div class="inputs"><div data-diagram-role="command">IncrementCounter<br /><strong>amount = 1 or 0</strong></div><span>+</span><div>Current counter<br /><strong>value = 2</strong></div></div>
  <div class="stem" aria-hidden="true"><svg width="20" height="28" viewBox="0 0 20 28" fill="none"><path d="M10 2v22m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" /></svg></div>
  <div class="decision">decide</div>
  <div class="branches">
    <div class="branch"><div class="condition">amount &gt; 0</div><div aria-hidden="true"><svg width="20" height="28" viewBox="0 0 20 28" fill="none"><path d="M10 2v22m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" /></svg></div><div data-diagram-role="event">Proposed CounterIncremented</div><div aria-hidden="true"><svg width="20" height="28" viewBox="0 0 20 28" fill="none"><path d="M10 2v22m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" /></svg></div><div>Stream check and append<br /><strong>Recorded event if successful</strong></div></div>
    <div class="branch refusal"><div class="condition">amount &lt;= 0</div><div aria-hidden="true"><svg width="20" height="28" viewBox="0 0 20 28" fill="none"><path d="M10 2v22m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" /></svg></div><div class="rejected">Rejected<br /><strong>Amount must be positive</strong><br />No append</div></div>
  </div>
</div>
<style>
.command-contract{font-size:16px;line-height:1.55;margin:2rem 0;padding:1.5rem 0}.command-contract *{margin:0}.inputs{display:flex;align-items:center;justify-content:center;gap:1rem}.inputs>div,.decision,.branch>div:not([aria-hidden]){padding:.75rem 1rem;border:1px solid var(--sl-color-gray-4);border-radius:4px}.inputs [data-diagram-role],.branch [data-diagram-role]{background:var(--diagram-surface);color:var(--diagram-ink);border-color:var(--diagram-line)}.stem{text-align:center;font-size:24px}.stem svg,.branch svg{display:block;margin:auto}.decision{width:max-content;margin:auto}.branches{display:grid;grid-template-columns:1fr 1fr;margin:0 1rem;border-top:1px solid var(--sl-color-gray-4);gap:1.5rem}.branch{text-align:center;border-top:0}.branch>.condition{border:0;border-radius:0;border-left:1px solid var(--sl-color-gray-4);width:max-content;margin:auto}.branch [aria-hidden]{font-size:24px}.rejected{border-color:var(--sl-color-red)!important;color:var(--sl-color-red)}
@media(max-width:550px){.inputs{flex-direction:column;gap:.5rem}.inputs>div{width:100%;text-align:center}.branches{grid-template-columns:1fr;border-top:0;border-left:1px solid var(--sl-color-gray-4);margin:0 0 0 .5rem;gap:1.5rem}.branch{position:relative;padding-left:1rem}.branch:before{content:"";position:absolute;left:0;top:1.5rem;width:1rem;border-top:1px solid var(--sl-color-gray-4)}.branch>.condition{border-left:0}.decision{margin-left:0}.refusal:after{content:"";position:absolute;left:-1px;top:calc(1.5rem + 1px);bottom:0;width:1px;background:var(--sl-color-bg)}}
</style>
