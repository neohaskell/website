<div class="identity-permissions" role="img" aria-label="The same verified customer follows two paths. Reading an order passes query access, then row ownership permits their own row or denies another owner's row. Cancelling passes command permission, then the decision checks the stored order and rejects the owner's dispatched order. No cancellation event is recorded.">
  <div class="caller">Same verified customer</div>
  <div class="paths">
    <section>
      <div class="link">Read order</div>
      <div class="node" data-diagram-role="query">canAccess: signed in</div>
      <div class="link">Stored row + caller</div>
      <div class="node">canView: owner matches?</div>
      <div class="outcomes">
        <div class="outcome" data-diagram-role="query">Own row: details returned</div>
        <div class="outcome denied">Other owner: not found</div>
      </div>
    </section>
    <section>
      <div class="link">Cancel order</div>
      <div class="node" data-diagram-role="command">canAccess: permission held</div>
      <div class="link">Stored order + caller</div>
      <div class="node">Decision: owner matches,<br />but already dispatched</div>
      <div class="outcomes">
        <div class="outcome denied">Rejected: no cancellation event</div>
      </div>
    </section>
  </div>
</div>
