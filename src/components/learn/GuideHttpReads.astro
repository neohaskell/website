.answer svg text{fill:var(--diagram-ink);stroke:none;font:24px var(--sl-font);}
.connection{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;color:var(--sl-color-gray-2);}
.connection svg{width:100%;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;}
@container(max-width:560px){.http-flow{grid-template-columns:1fr;gap:16px;}.connection{gap:4px;}.connection svg{width:40px;height:32px;transform:rotate(90deg);}.operation strong{overflow-wrap:normal;}}
</style>
