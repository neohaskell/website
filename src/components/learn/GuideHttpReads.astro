<style>
.http-reads{container-type:inline-size;margin:32px 0;}
.http-flow{display:grid;grid-template-columns:minmax(0,1fr) 56px minmax(0,1fr) 72px minmax(0,1fr);align-items:center;gap:8px;font-size:16px;line-height:1.5;}
.operation{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;min-width:0;color:var(--diagram-ink);}
.operation strong{font-size:16px;font-weight:500;overflow-wrap:anywhere;}
.operation span{color:var(--sl-color-gray-2);}
.operation svg{width:64px;height:64px;fill:var(--diagram-surface);stroke:var(--diagram-line);stroke-width:1.5;}
